<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Service Project Categories</h2>
        <ul class="content-grid">
            <% category.forEach(category=> { %>
            <li class="grid-card"><strong>
                    <%= category.category_name %>
                </strong>
                <a href="/category/<%= category.category_id %>"><strong><%= category.category_name%></strong></a></li>
                <% }); %>           
        </ul>
        <p><a href="/new-category">Add a new category</a></p>
    </main>
    <%- include('partials/footer') %>