<%- include('partials/header') %>
 <main> 
    <h1>
            <%= project.title || "No Title Found" %>
        </h1>
        <p>
            <%= project.description || "No Description" %>
        </p>
        <h3><%= new Date(project.date).toLocaleDateString('en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        year: 'numeric'})
        || "No Date" %></h3>
        <h4><%= project.location || "No Location" %></h4>
        <p>
                <a href="/organization/<%= project.organization_id %>">    <%= project.organization_name  || "No Organization Name "%>
                
                </a>
                </p>
                <h5>Project Categories:</h5>
                <% categories.forEach(function(cat) {%>
                    <a href="/category/<%= cat.category_id %>">
                        <%= cat.category_name || "No Category Name " %>
                    
                    </a><%}); %>
            <p>
                <a href="/assign-categories/<%= project_id %>">Edit Categories</a>
                <!-- <a href="/assign-categories/<%= project.project_id || projectDetails.project_id || project_id || 'NO_ID_FOUND' %>">Edit -->
                    </a>
                    <a href="/edit-project/<%= project_id %>">Edit Project</a>
                    <!-- <a href="/edit-project/<%= project.project_id || projectDetails.project_id || project_id || 'NO_ID_FOUND' %>">Edit -->
                    </a>
            </p>
    </main>
    <%- include('partials/footer') %>