<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">
            <div class="form-group">
                <label for="name" >Organazation Name</label>
                <input type="text" id="name" name="name" value="<%= organizationDetails.name %>" required maxlength="150" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="500"><%= organizationDetails.description%></textarea>
            </div>

            <div class="form-group">
                <label for="contact_email">Contact Email</label>
                <input type="email" required id="contact_email" name="contact_email" maxlength="255" required value="<%= organizationDetails.contact_email%>"/>
            </div>
<div class="form-group">
    <label for="logo_filename">Logo Filename</label>
    <input type="text" id="logo_filename" maxlength="255" required value="<%= organizationDetails.logo_filename %>"/>  
</div>
            <button type="submit">Update Organization</button>
        </form>

    </main>
    <%- include('partials/footer') %>