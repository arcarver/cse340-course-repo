<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Dashboard</h2>
        <p>Name: <%= name%></p>
        <p>Username: <%= email %></p>
       
       <ul class="content-grid">
    <% if (typeof volunteer !== 'undefined' && volunteer.length > 0) { %>
    <% volunteer.forEach(project => { %>
<li class="grid-card">
        <%= project.title %>
            <button type="button" >You are already signed up to volunteer</button>
    </li>
    <li class="grid-card">
        <%= project.title %>
       <button type="button">UnVolunteer</button> </li>
    <% }) %> 
    <% } else { %>
    
    <li class="grid-card">
        <p> You have are not yet signed up to volunteer</p>
            <!-- <button type="button" onclick="volunteer">Volunteer</button> -->
    </li>
    
    <% } %>
        </ul> 
        
        <% if (user && user.role_name==='admin' ) { %>
            <li> <a href="/users">Current Users</a>
            </li>
            <% } %>
    <%- include('partials/footer') %>