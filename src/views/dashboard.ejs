<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Dashboard</h2>
        <p>Name: <%= name%></p>
        <p>Username: <%= email %></p>
       
       <ul class="content-grid">
    <% if (typeof volunteer !== 'undefined' && volunteer.length > 0) { %>
    <% volunteer.forEach(project => { %>
        <li class="grid-card">
        <span class="title"><%= project.title %></span>
        <form action="/dashboard/cancel" method="post" class="cancel">
       <input type="hidden" name="project_id" value="<%= project.project_id %>">
            <button type="submit" class="button_cancel_signup">Cancel Signup</button> 
            </form>
            </li>
    <% }) %> 
    <% } else { %>
    
    <li class="grid-card">
        <p> You have are not signed up to volunteer</p>
            <!-- <button type="button" onclick="volunteer">Volunteer</button> -->
    </li>
    
    <% } %>
        </ul> 
        
        <% if (user && user.role_name==='admin' ) { %>
            <li> <a href="/users">Current Users</a>
            </li>
            <% } %>
    <%- include('partials/footer') %>