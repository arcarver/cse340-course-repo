<%- include('partials/header') %>
    <main>
        <h1><%= organization.name %></h1>
        <p>Here are a few of our partner organizations:</p>
        <ul class="content-grid">
            <% organization.forEach(organization=> { %>
                <li class="grid-card"><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><a href="/organization/<%= organization.organization_id %>">
                    <%= organization.name %>
                </a><strong>
                        <%= organization.name %>
                    </strong>: <%= organization.contact_email %>
                </li>
                 <% }); %>
        </ul>
<p><a href="/new-organization">Add a new organization</a></p>
</main>
<%- include('partials/footer') %>