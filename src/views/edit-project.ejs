<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/edit-project/<%= projectDetails.service_project_id %>" method="POST">
            <div class="form-group">
                <label for="name">Project Name</label>
                <input type="text" id="title" name="title" value="<%= projectDetails.title %>" required
                    maxlength="150" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required
                    maxlength="500"><%= projectDetails.description%></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" required id="location" name="location" maxlength="255" required
                    value="<%= projectDetails.location%>" />
            </div>
            <div class="form-group">
                <label for="project_date">Project Date</label>
                <!-- AI help with date formating -->
                <% let formattedDate="" ; if (projectDetails.project_date) { formattedDate=new
                    Date(projectDetails.project_date).toISOString().split('T')[0]; } %>
                    // end Ai help
                <input type="date" id="project_date" name="project_date" maxlength="255" required
                    value="<%= projectDetails.project_date %>" />
            </div>
            <div class="form-group">
                <label for="organization_id">Organization</label>
                <select id="organization_id" name="organization_id" required>
                    <option value="">Select an Organization</option>
                    <% organizationList.forEach(organization=> { %>
                        <option value="<%= organization.organization_id %>">
                            <%= org.organization_id===projectDetails.organization_id ? 'selected' : '' %>>
                            <%= organization.name %>
                        </option>
                        <% }); %>
                </select>
            </div>
            <button type="submit">Update Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>