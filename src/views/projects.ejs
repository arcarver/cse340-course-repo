<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul class="content-grid">
        <% project.forEach(project => { %>
            
        <li class="grid-card"><%= new Date(project.project_date).toLocaleDateString('en-US', {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        }) %><strong> <%= project.title %></strong>
            (<%= project.name %>)
         
    </li>
    <% }); %>
        
    </ul>
    </main>
    <%- include('partials/footer') %>