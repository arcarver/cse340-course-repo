<%- include('partials/header') %>
    <main>
        <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    <ul class="content-grid">
        <% project.forEach(project => { %>
            
        <li class="grid-card"><%= new Date(project.date).toLocaleDateString('en-US', {
            weekday: 'short',
            month: 'short',
            day: 'numeric',
            year: 'numeric'
        }) %>
        <a href="/project/<%= project.project_id %>"> <%= project.title %></a>
            <a href="/organization/<%= project.organization_id %>" ><%= project.name %></a>
         
    </li>
   
    <% }); %>
        
    </ul>
    <p>
        <a href="/new-project/">Add a New Service Project</a>
    
    </p>
    </main>
    <%- include('partials/footer') %>