<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <form action="/new-project" method="POST">
            <div class="form-group">
                <label for="title" >Project Name</label>
                <input type="text" required maxlength="150" id="title" name="title" />
            </div>

            <div class="form-group">
                <label for="description">Description</label>
                <textarea id="description" name="description" required maxlength="500"></textarea>
            </div>

            <div class="form-group">
                <label for="location">Location</label>
                <input type="text" maxlength="255" required id="location" name="location" />
            </div>

            <div class="form-group">
                <label for="project_date">Date</label>
                <input type="date" required  id="project_date" name="project_date" />
            </div>

            <div class="'form-group">
                <label for="organization_id">Organization</label>
               <select id="organization_id" name="organization_id" required>
                <option value="">Select an Organization</option> 
                <% organizations.forEach(organization => { %>
                 <option value="<%= organization.organization_id %>"><%= organization.name %></option>
                <% }); %>
                </select>
            </div>

            <button type="submit">Create Project</button>
        </form>

    </main>
    <%- include('partials/footer') %>